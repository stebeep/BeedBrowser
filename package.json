{
  "name": "beedbrowser",
  "productName": "BeedBrowser",
  "version": "1.0.0",
  "description": "BeedBrowser - a fast, minimalist, premium desktop web browser for Windows",
  "author": {
    "name": "BeedBrowser",
    "email": "hello@beedbrowser.app"
  },
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.mjs",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "icons": "node scripts/run-electron.mjs scripts/build-icons.cjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "dev": "electron-vite dev",
    "build": "npm run icons && npm run typecheck && electron-vite build",
    "build:app": "electron-vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --x64 --config electron-builder.yml",
    "dist:portable": "npm run build && electron-builder --win portable --x64 --config electron-builder.yml",
    "dist:installer": "npm run build && electron-builder --win nsis --x64 --config electron-builder.yml",
    "dist:dir": "npm run build:app && electron-builder --win --x64 --dir --config electron-builder.yml",
    "shot": "node scripts/screenshot.mjs",
    "smoke": "npm run build:app && node scripts/smoke-test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/inter": "^5.1.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
